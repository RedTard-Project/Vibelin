/obj/item/clothing/head/helmkleinod
	abstract_type = /obj/item/clothing/head/helmkleinod
	name = "helmkleinod"
	desc = "A crest made to sit on top of a helmet."
	icon = 'modular_abel/twilight_wardrobe/icons/twilight_wardrobe_world.dmi'
	mob_overlay_icon = 'modular_abel/twilight_wardrobe/icons/twilight_wardrobe_onmob48.dmi'
	slot_flags = ITEM_SLOT_HEAD|ITEM_SLOT_MASK
	body_parts_covered = null
	sellprice = 25

/obj/item/clothing/head/helmkleinod/chaperon
	name = "helm's chaperon"
	desc = "A cloth burlet wound over a helmet. It keeps the sun off the steel and puts the wearer's colours where they can be seen."
	icon_state = "d_basic"

/obj/item/clothing/head/helmkleinod/castle
	name = "castle helmkleinod"
	desc = "A crest shaped like a turret. Fastened to a helm it claims a defence that has not given ground yet."
	icon_state = "d_castle_red"

/obj/item/clothing/head/helmkleinod/dragon
	name = "dragon's dread"
	desc = "A helm ornament in the shape of a wyrm. It casts a long shadow, which is most of what it is for."
	icon_state = "d_dragon_red"
	sellprice = 40

/obj/item/clothing/head/helmkleinod/afreet
	name = "afreet helmkleinod"
	desc = "A crest forged in the likeness of an afreet, its face caught mid-snarl like a fire that has not finished with you."
	icon_state = "d_efreet"
	sellprice = 40

/obj/item/clothing/head/helmkleinod/feathers
	name = "feathered crest"
	desc = "A cluster of bright plumage pinned to a helmet. Expensive birds, worn by men who want that understood."
	icon_state = "d_feathers"

/obj/item/clothing/head/helmkleinod/fish
	name = "gilded fish helmkleinod"
	desc = "A gilded fish riding the crown of a helm. Riverland lords favour it and call it prosperity."
	icon_state = "d_fish"

/obj/item/clothing/head/helmkleinod/bloodied_star
	name = "bloodied star helmkleinod"
	desc = "A jagged star, stained dark and never scrubbed. Its wearer is announcing something about how they fight."
	icon_state = "d_graggar"
	sellprice = 40

/obj/item/clothing/head/helmkleinod/horns
	name = "horned helmkleinod"
	desc = "A pair of iron horns mounted over the brow, turning a helmet's outline into something with a temper."
	icon_state = "d_horns"

/obj/item/clothing/head/helmkleinod/lion
	name = "lion helmkleinod"
	desc = "A lion cast mid-roar. Courage, royalty, and a quantity of metal balanced on the skull."
	icon_state = "d_lion"

/obj/item/clothing/head/helmkleinod/astrata
	name = "astrata's eye helmkleinod"
	desc = "A crest worked into the Sun Queen's eye. A reminder of the gaze above, and of who is being watched by it."
	icon_state = "d_peace"

/obj/item/clothing/head/helmkleinod/skull
	name = "gilded skull helmkleinod"
	desc = "An opulent golden skull. A memento mori for the kind of warrior who can afford one in gold."
	icon_state = "d_skull"
	sellprice = 40

/obj/item/clothing/head/helmkleinod/sun
	name = "sun helmkleinod"
	desc = "A gilded sunburst crowning the helm, cut to catch every bit of light there is to catch."
	icon_state = "d_sun"

/obj/item/clothing/head/helmkleinod/swan
	name = "swan helmkleinod"
	desc = "A swan at rest on still water, worked in fine detail. Calm, and rather pleased about it."
	icon_state = "d_swan"

/obj/item/clothing/head/helmkleinod/windmill
	name = "windmill helmkleinod"
	desc = "A windmill crest, humble at first glance. It says the wearer's country is flat, windy and theirs."
	icon_state = "d_windmill"

/obj/item/clothing/head/antlers
	name = "old antlers"
	desc = "A weathered rack of antlers, mounted to sit on a helmet, a hood, or directly on the head of someone committed to it."
	icon = 'modular_abel/twilight_wardrobe/icons/twilight_wardrobe_world.dmi'
	mob_overlay_icon = 'modular_abel/twilight_wardrobe/icons/twilight_wardrobe_onmob48.dmi'
	icon_state = "antlers"
	slot_flags = ITEM_SLOT_HEAD|ITEM_SLOT_MASK
	body_parts_covered = null
	sellprice = 35

/obj/item/clothing/head/roguehood/bishop
	name = "bishop's hood"
	desc = "A deep hood of heavy cloth, cut long at the shoulder. It leaves very little of the face for a congregation to read."
	icon = 'modular_abel/twilight_wardrobe/icons/twilight_wardrobe_world.dmi'
	mob_overlay_icon = 'modular_abel/twilight_wardrobe/icons/twilight_wardrobe_onmob.dmi'
	icon_state = "bishop_hood"
	sellprice = 45

/obj/item/clothing/face/bishopmask
	name = "bishop's mask"
	desc = "A pale mask worn with the hood. Whatever office it belongs to, it prefers to be recognised by the shape rather than the man."
	icon = 'modular_abel/twilight_wardrobe/icons/twilight_wardrobe_world.dmi'
	mob_overlay_icon = 'modular_abel/twilight_wardrobe/icons/twilight_wardrobe_onmob.dmi'
	icon_state = "bishop_mask"
	sellprice = 45

/obj/item/clothing/head/roguehood/noble
	name = "silk hood"
	desc = "A silk hood that costs more than the coat under it, which is the entire argument it makes."
	icon = 'modular_abel/twilight_wardrobe/icons/twilight_wardrobe_world.dmi'
	mob_overlay_icon = 'modular_abel/twilight_wardrobe/icons/twilight_wardrobe_onmob.dmi'
	icon_state = "burgerhood"
	sellprice = 50

/obj/item/clothing/cloak/elven_short
	name = "elven shortcloak"
	desc = "A short cloak in a pattern said to predate the War in Heaven. The elves who say so are not taking questions."
	icon = 'modular_abel/twilight_wardrobe/icons/twilight_wardrobe_world.dmi'
	mob_overlay_icon = 'modular_abel/twilight_wardrobe/icons/twilight_wardrobe_onmob.dmi'
	icon_state = "cape_short"
	sellprice = 55

/obj/item/clothing/cloak/desert
	name = "desert cloak"
	desc = "Loose pale cloth cut for dust and glare. It does nothing for the heat and everything for the sand."
	icon = 'modular_abel/twilight_wardrobe/icons/twilight_wardrobe_world.dmi'
	mob_overlay_icon = 'modular_abel/twilight_wardrobe/icons/twilight_wardrobe_onmob.dmi'
	icon_state = "desert_cloak"
	sellprice = 45

